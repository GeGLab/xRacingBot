# ============================================
# XRacing Notifier - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com os seus valores reais.
#
# 1. Vá ao Discord Developer Portal: https://discord.com/developers/applications
# 2. Selecione a sua aplicação (ou crie uma nova)
# 3. Copie o "Application ID" (é o mesmo que Client ID)
# 4. Cole abaixo:

VITE_DISCORD_CLIENT_ID=1293240938574909440

# URL base do site (usada para canonical, OG tags, etc.)
# Em desenvolvimento pode deixar vazio ou usar http://localhost:5173
VITE_SITE_URL=https://xracingnotifier.com
