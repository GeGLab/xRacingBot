# =============================================================================
# XRacing Notifier - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# API - Discord Bot & Backend
# -----------------------------------------------------------------------------

# Discord bot token (required)
# Get it at: https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# YouTube channels to monitor (required)
# Format: NAME:CHANNEL_ID (comma-separated for multiple channels)
# Example: xracing:UCW3oIxTLllTLK3Vy9jzdoEg,other:UCxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNELS=xracing:UCW3oIxTLllTLK3Vy9jzdoEg

# Port the API server will listen on (default: 3000)
PORT=3000

# Public URL used for YouTube PubSubHubbub webhook callbacks (optional)
# Required if you want real-time YouTube notifications via push (instead of polling)
# Example: https://api.xracingnotifier.com
YOUTUBE_CALLBACK_URL=https://api.seu-dominio.com/webhook/youtube

# Secret used to validate incoming YouTube webhook payloads.
# Required when YOUTUBE_CALLBACK_URL is set. Use a long, random value.
WEBHOOK_SECRET=generate_a_long_random_secret_before_deploying

# -----------------------------------------------------------------------------
# Front - React / Vite
# -----------------------------------------------------------------------------

# Discord OAuth2 Client ID (required for login with Discord)
# Get it at: https://discord.com/developers/applications -> OAuth2 -> Client ID
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# Public URL of the frontend (used for OAuth2 redirects and meta tags)
VITE_SITE_URL=https://xracingnotifier.com
