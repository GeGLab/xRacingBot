# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ─── YouTube ────────────────────────────────────────────────────────────────
# YouTube channel ID to monitor (from the channel URL)
# How to find it: visit the channel page → View Page Source → search "browse_id"
YOUTUBE_CHANNEL_ID=UCuAXFkgsw1L7xaCfnd5JJOw

# ─── HTTP Server ────────────────────────────────────────────────────────────
PORT=3000

# ─── YouTube PubSubHubbub Webhook (optional) ────────────────────────────────
# Public URL that YouTube will POST new-video notifications to.
# Example: https://yourapp.ngrok.io/webhook/youtube
# Leave empty to use cron-only mode (RSS polling every 5 minutes).
YOUTUBE_CALLBACK_URL=

# Optional secret for verifying webhook payloads (future use)
WEBHOOK_SECRET=

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
